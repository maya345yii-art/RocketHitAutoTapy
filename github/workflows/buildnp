name: Build Rocket Hit APK

on:
  workflow_dispatch:
  push:
    paths:
      - "RocketHitAutoTap-complete-source.zip"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: android-actions/setup-android@v3

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9

      - name: Extract source
        run: unzip RocketHitAutoTap-complete-source.zip

      - name: Build APK
        run: gradle -p RocketHitAutoTap assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: RocketHitAutoTap-APK
          path: RocketHitAutoTap/app/build/outputs/apk/debug/app-debug.apk
